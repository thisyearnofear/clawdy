{
  "name": "clawdy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "git config core.hooksPath .husky",
    "test": "vitest run",
    "starter:train": "tsx starter/train.ts",
    "print:stl": "python3 scripts/export-print-stl.py public/assets/mint/champion-rover.glb public/prints/champion-rover.stl",
    "eval:holdout": "tsx scripts/eval-holdout.ts",
    "eval:gate": "tsx scripts/eval-gate.ts",
    "analyze:legs": "tsx scripts/analyze-legs.ts",
    "terrain:build": "blender --background --factory-startup --python scripts/build-arena-terrain.py",
    "mint:sync": "node .devin/skills/mint-threejs-skills/scripts/sync-mint-assets.mjs",
    "postinstall": "node -e \"const v=JSON.parse(require('fs').readFileSync(require.resolve('@dimforge/rapier3d-compat').replace(/\\/[^\\/]*$/,'/package.json'),'utf8')).version;if(!v.startsWith('0.19')){console.error('WRONG rapier:',v);process.exit(1)}console.log('rapier3d-compat:',v)\""
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@sentry/nextjs": "^10.73.0",
    "@sparkjsdev/spark": "^2.2.0",
    "@types/three": "^0.186.0",
    "convex": "^1.46.0",
    "lucide-react": "^0.563.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "@dimforge/rapier3d-compat": "0.19.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "^0.0.60",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
