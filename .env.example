# Sentry error monitoring (builds stay DSN-gated: no capture until set in prod)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Reactor / Visko Orbis broadcast layer (docs/SCENES.md AI-video stage)
# Server-side only — the browser receives a session-scoped JWT from
# /api/reactor/token. Leave unset to run everything except live broadcast;
# the Storyboard mode of the broadcast panel works without it.
REACTOR_API_KEY=

# Convex (Season 0 coaching / checkpoint / match sync — exhibition guest keys)
# Local: `npx convex dev` fills these. Production: set NEXT_PUBLIC_CONVEX_URL
# to the *prod* deployment URL on Vercel, then redeploy.
# App runs localStorage-cached + Convex system-of-record sync; offline-first when unset.
# Not Convex Auth — guest keys only.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Orbis broadcast layer (docs/SCENES.md) — server-side only, never NEXT_PUBLIC
REACTOR_API_KEY=

# Steal-highlight clip (optional, presentation only — docs/SCENES.md)
# Server-side only. When unset, Raider full-load steal PIP uses a stub poster
# storyboard that works offline. When set, POST /api/steal-highlight may upgrade
# to a short fal clip; late/failed gen never blocks the match or changes score.
FAL_KEY=

# Coach-intent / arena-intent / doctrine / caster LLM translators
# (docs/AI_BUILDER_HACKATHON.md, Tracks A–D). Server-side only — the browser
# talks to /api/coach-intent, /api/arena-intent, /api/doctrine and
# /api/caster, never to the provider. Any OpenAI-compatible chat-completions
# endpoint works. When unset, the routes return 503 and the app falls back to
# the keyword matcher / preset Clash / deterministic captions with an honest
# message. One key covers all four surfaces.
COACH_INTENT_API_KEY=
# COACH_INTENT_BASE_URL=https://api.openai.com/v1
# COACH_INTENT_MODEL=gpt-4o-mini
# Fallback provider — tried when the primary 429s, runs dry, or times out
# (services/llmProviders.ts):
# COACH_INTENT_FALLBACK_BASE_URL=
# COACH_INTENT_FALLBACK_API_KEY=
# COACH_INTENT_FALLBACK_MODEL=
# Prefer non-reasoning models: reasoning models burn max_tokens on hidden
# reasoning and truncate (verified live Nov 10: xiaomi/mimo-v2.6-pro).
# Optional per-surface overrides (fall back to the COACH_INTENT_* values):
# DOCTRINE_API_KEY=        # falls back to COACH_INTENT_API_KEY
# DOCTRINE_BASE_URL=
# DOCTRINE_MODEL=
# CASTER_MODEL=

