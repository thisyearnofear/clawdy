# Sentry error monitoring (builds stay DSN-gated: no capture until set in prod)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Reactor / Visko Orbis broadcast layer (docs/SCENES.md AI-video stage)
# Server-side only — the browser receives a session-scoped JWT from
# /api/reactor/token. Leave unset to run everything except live broadcast;
# the Storyboard mode of the broadcast panel works without it.
REACTOR_API_KEY=

# Convex (Season 0 coaching / checkpoint / match sync — exhibition guest keys)
# Local: `npx convex dev` fills these. Production: set NEXT_PUBLIC_CONVEX_URL
# to the *prod* deployment URL on Vercel, then redeploy.
# App runs localStorage-cached + Convex system-of-record sync; offline-first when unset.
# Not Convex Auth — guest keys only.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Orbis broadcast layer (docs/SCENES.md) — server-side only, never NEXT_PUBLIC
REACTOR_API_KEY=

# Steal-highlight clip (optional, presentation only — docs/SCENES.md)
# Server-side only. When unset, Raider full-load steal PIP uses a stub poster
# storyboard that works offline. When set, POST /api/steal-highlight may upgrade
# to a short fal clip; late/failed gen never blocks the match or changes score.
FAL_KEY=

